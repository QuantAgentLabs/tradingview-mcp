{
  "name": "tradingview-mcp",
  "version": "1.0.0",
  "description": "Codex-ready MCP bridge for TradingView Desktop via Chrome DevTools Protocol",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "tv": "src/cli/index.js"
  },
  "exports": {
    ".": "./src/server.js",
    "./core": "./src/core/index.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "tv": "node src/cli/index.js",
    "docker:build": "docker compose build",
    "docker:mcp": "docker compose run --rm -T tradingview-mcp",
    "docker:tv": "docker compose run --rm tv",
    "docker:status": "docker compose run --rm tv status",
    "docker:quote": "docker compose run --rm tv quote",
    "docker:screenshot": "docker compose run --rm tv screenshot -r chart",
    "orb:launch": "./scripts/launch_tv_debug_mac.sh",
    "orb:build": "npm run docker:build",
    "orb:mcp": "npm run docker:mcp",
    "orb:tv": "npm run docker:tv --",
    "orb:status": "npm run docker:status",
    "orb:quote": "npm run docker:quote",
    "orb:screenshot": "npm run docker:screenshot",
    "orb:setup": "npm run orb:launch && npm run orb:build",
    "test": "node --test tests/e2e.test.js tests/pine_analyze.test.js",
    "test:e2e": "node --test tests/e2e.test.js",
    "test:unit": "node --test tests/pine_analyze.test.js tests/cli.test.js",
    "test:cli": "node --test tests/cli.test.js",
    "test:all": "node --test tests/e2e.test.js tests/pine_analyze.test.js tests/cli.test.js",
    "test:verbose": "node --test --test-reporter=spec tests/e2e.test.js tests/pine_analyze.test.js",
    "test:count": "node --test --test-reporter=spec tests/e2e.test.js 2>&1 | tail -5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chrome-remote-interface": "^0.33.2"
  }
}
